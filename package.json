{
	"name": "tencent-cos-uploader",
	"version": "1.0.0",
	"description": "Upload images and attachments to Tencent Cloud COS for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tencent-cos",
		"cos",
		"image-uploader",
		"attachment-uploader"
	],
	"author": "obsidian-link",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"esbuild": "0.25.5",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"cos-js-sdk-v5": "^1.8.7"
	}
}
